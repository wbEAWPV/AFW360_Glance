# Line endings. core.autocrlf=true on this machine would otherwise check text
# files out with CRLF in every new worktree, which breaks the LF rule and the
# byte-identity checks on generated files (see .docs/transition.qmd).
*.csv    text eol=lf
*.R      text eol=lf
*.md     text eol=lf
*.qmd    text eol=lf
*.xml text eol=lf
*.xsd text eol=lf
*.sha256 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
requirements.txt text eol=lf
metadata/VERSION text eol=lf
VERSION text eol=lf

# Raw legacy inputs are byte-frozen: never convert them.
data_raw/** -text

*.gpkg binary
*.xlsx binary
*.png  binary
